@using Digbyswift.Umbraco.CountryPicker.Core.Models
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
	Layout = null;

	var singleCountry = Model.Value<Country>("country");
	var multipleCountries = Model.Value<Country[]>("countries") ?? [];
}


<h2>Single country</h2>

@if (singleCountry != null)
{
	
	<p>
		<dl>
			<dt>Name</dt>
			<dd>@singleCountry.Name</dd>
			<dt>Code</dt>
			<dd>@singleCountry.Code</dd>
			<dt>Code3</dt>
			<dd>@singleCountry.Code3</dd>
			<dt>Flag URL</dt>
			<dd><img src="@singleCountry.Flag" alt="@singleCountry.Name" width="30" height="30" /></dd>
		</dl>
	</p>
}
else
{
	<p>None selected</p>
}

<hr />

<h2>Country array</h2>

@if (multipleCountries.Any())
{
	foreach (var country in multipleCountries)
	{
		<p>
			<dl>
				<dt>Name</dt>
				<dd>@country.Name</dd>
				<dt>Code</dt>
				<dd>@country.Code</dd>
				<dt>Code3</dt>
				<dd>@country.Code3</dd>
				<dt>Flag URL</dt>
				<dd><img src="@country.Flag" alt="@country.Name" width="30" height="30" /></dd>
			</dl>
		</p>
	}
}
else
{
	<p>None selected</p>
}
